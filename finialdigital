import cv2
import numpy as np
import time
import matplotlib.pyplot as plt
from skimage.metrics import structural_similarity as ssim

def estimate_noise(image):
    # Basit bir gürültü tahmin algoritması (Laplacian varyansı)
    gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)
    return np.var(cv2.Laplacian(gray, cv2.CV_64F))

def noise_calibrated_canny(image):
    gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)
    
    # 1. Gürültü Tahmini ve Gaussian Blur adaptasyonu
    noise_level = estimate_noise(image)
    if noise_level < 100:
        blur_ksize = (3, 3)
    elif noise_level < 500:
        blur_ksize = (5, 5)
    else:
        blur_ksize = (7, 7)
        
    blurred = cv2.GaussianBlur(gray, blur_ksize, 0)
    
    # 2. Otsu metodu ile otomatik eşik belirleme
    high_thresh, _ = cv2.threshold(blurred, 0, 255, cv2.THRESH_BINARY + cv2.THRESH_OTSU)
    low_thresh = 0.5 * high_thresh
    
    # 3. Canny Uygulaması
    edges = cv2.Canny(blurred, low_thresh, high_thresh)
    return edges, blur_ksize, low_thresh, high_thresh

def standard_canny(image):
    gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)
    blurred = cv2.GaussianBlur(gray, (5, 5), 0)
    # Sabit eşik değerleri (literatürde sık kullanılan baseline)
    edges = cv2.Canny(blurred, 100, 200)
    return edges

# --- TEST KISMI ---
# Kendi bilgisayarındaki bir resmin yolunu buraya yaz (örneğin BSDS500'den bir kare)
image_path = 'test_image.jpg' 
img = cv2.imread(image_path)

if img is None:
    print("Lütfen 'test_image.jpg' adında bir resmi kodla aynı dizine koyun.")
else:
    # Sentetik gürültü ekleme
    noise = np.random.normal(0, 25, img.shape).astype(np.uint8)
    noisy_img = cv2.add(img, noise)

    # Standart Canny Süresi ve Sonucu
    start_time = time.time()
    edges_std = standard_canny(noisy_img)
    std_time = time.time() - start_time

    # NCC Süresi ve Sonucu
    start_time = time.time()
    edges_ncc, ksize, low_t, high_t = noise_calibrated_canny(noisy_img)
    ncc_time = time.time() - start_time

    print(f"Standart Canny Çalışma Süresi: {std_time:.4f} sn")
    print(f"NCC Çalışma Süresi: {ncc_time:.4f} sn")
    print(f"NCC Otomatik Parametreleri: Blur Kernel {ksize}, Eşikler: {low_t:.1f} - {high_t:.1f}")

    # Görselleştirme
    plt.figure(figsize=(12, 4))
    plt.subplot(1, 3, 1), plt.imshow(cv2.cvtColor(noisy_img, cv2.COLOR_BGR2RGB)), plt.title('Noisy Input')
    plt.subplot(1, 3, 2), plt.imshow(edges_std, cmap='gray'), plt.title('Standard Canny')
    plt.subplot(1, 3, 3), plt.imshow(edges_ncc, cmap='gray'), plt.title('NCC (Proposed)')
    plt.tight_layout()
    plt.savefig('result_comparison.png')
    plt.show()